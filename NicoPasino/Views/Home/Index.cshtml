<!-- Script -->
@section Scripts {
<script src="~/lib/glightbox/js/glightbox.min.js"></script>
<script>
    // Acordeón: toggle expand/collapse
    function toggleAccordion(header) {
        const accordion = header.parentElement;
        const wasActive = accordion.classList.contains('active');

        document.querySelectorAll('.accordion.active').forEach(a => {
            a.classList.remove('active');
        });

        if (!wasActive) {
            accordion.classList.add('active');
        }
    }

    // Typewriter: frases rotativas con efecto escritura/borrado
    (function () {
        const el = document.getElementById('typewriter-text');
        const frases = [
            "Creo soluciones que no solo funcionan, sino que brillan en la oscuridad del espacio digital.",
            "Transformo ideas en código que brilla y experiencias que impactan en el universo digital.",
            "Construyo software que enciende la noche: funcional, elegante y con alma de explorador."
        ];
        const typewriterDelay = 40;
        const deleteDelay = 15;
        const pauseDelay = 2500;
        let fraseIndex = 0;
        let charIndex = 0;
        let isDeleting = false;

        function tick() {
            const fraseActual = frases[fraseIndex];
            if (!isDeleting) {
                el.textContent = fraseActual.substring(0, charIndex + 1);
                charIndex++;
                if (charIndex === fraseActual.length) {
                    setTimeout(() => { isDeleting = true; tick(); }, pauseDelay);
                    return;
                }
                setTimeout(tick, typewriterDelay);
            } else {
                el.textContent = fraseActual.substring(0, charIndex - 1);
                charIndex--;
                if (charIndex === 0) {
                    isDeleting = false;
                    fraseIndex = (fraseIndex + 1) % frases.length;
                    setTimeout(tick, typewriterDelay);
                    return;
                }
                setTimeout(tick, deleteDelay);
            }
        }

        tick();
    })();

    // GLightbox: preview de imagen al hacer click
    GLightbox({ selector: '.glightbox', touchNavigation: true, loop: true });

    // Abrir acordeón desde URL hash
    if (window.location.hash) {
        const id = window.location.hash.substring(1);
        const target = document.getElementById(id);
        if (target) {
            setTimeout(() => {
                target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                const accordion = target.querySelector('.accordion');
                if (accordion) {
                    accordion.classList.add('active');
                }
            }, 100);
        }
    }
</script>
}
