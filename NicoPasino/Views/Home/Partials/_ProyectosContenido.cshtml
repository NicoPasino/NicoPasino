@{
    var dominio = "nicopasino.space";
}

<!-- ==================== PROYECTO 1: App Vendedores ==================== -->
<section class="proyecto-seccion" id="app-vendedores">
    <div class="accordion">
        <button class="accordion-header" onclick="toggleAccordion(this)">
            <div class="accordion-header-left">
                <div class="accordion-icon">
                    <img src="~/imgs/icons/React.svg" alt="React">
                </div>
                <div>
                    <h3 class="accordion-title">App Vendedores</h3>
                    <p class="accordion-subtitle">Vende donde quieras, incluso en la luna.</p>
                </div>
            </div>
            <div class="accordion-header-right">
                <img src="~/imgs/icons/React.svg" alt="React" title="React">
                <img src="~/imgs/icons/Nodejs.svg" alt="Node.js" title="Node.js">
                <img src="~/imgs/icons/mysql.svg" alt="MySQL" title="MySQL">
            </div>
            <span class="accordion-arrow">▼</span>
        </button>
        <div class="accordion-panel">
            <div class="accordion-body">

                <div class="proyecto-info-grid">
                    <div class="info-block">
                        <h4 class="info-block-title">Descripción</h4>
                        <p>Plataforma web completa dirigida a vendedores. Permite gestionar stock, visualizar estadísticas de ventas en tiempo real y administrar clientes desde cualquier dispositivo. Diseñada para ser intuitiva y eficiente.</p>
                    </div>
                    <div class="info-block">
                        <h4 class="info-block-title">Características</h4>
                        <ul>
                            <li>Gestión de stock y productos</li>
                            <li>Panel de administrador</li>
                            <li>Autenticación segura del usuario</li>
                            <li>Arquitectura limpia y escalable</li>
                        </ul>
                    </div>
                </div>

                <div class="info-block" style="margin-bottom: 1.5rem;">
                    <h4 class="info-block-title">Tecnologías</h4>
                    <div class="tech-grid">
                        <span class="tech-badge"><img src="~/imgs/icons/React.svg" alt="React"> React</span>
                        <span class="tech-badge"><img src="~/imgs/icons/Nodejs.svg" alt="Node.js"> Node.js</span>
                        <span class="tech-badge"><img src="~/imgs/icons/mysql.svg" alt="MySQL"> MySQL</span>
                    </div>
                </div>

                <div class="info-block" style="margin-bottom: 1.5rem;">
                    <h4 class="info-block-title">Capturas</h4>
                    <div class="capturas-grid">
                        <div class="captura-item">
                            <a href="~/imgs/captures/app-vendedores/index.png" class="glightbox">
                                <img src="~/imgs/captures/app-vendedores/index.png" alt="App Vendedores - Index">
                            </a>
                            <div class="captura-caption">Página principal</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/app-vendedores/cart.png" class="glightbox">
                                <img src="~/imgs/captures/app-vendedores/cart.png" alt="App Vendedores - Carrito de ventas">
                            </a>
                            <div class="captura-caption">Carrito de ventas</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/app-vendedores/admin-editar-producto.png" class="glightbox">
                                <img src="~/imgs/captures/app-vendedores/admin-editar-producto.png" alt="App Vendedores - Editar producto">
                            </a>
                            <div class="captura-caption">Editar productos</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/app-vendedores/admin-login.png" class="glightbox">
                                <img src="~/imgs/captures/app-vendedores/admin-login.png" alt="App Vendedores - Login">
                            </a>
                            <div class="captura-caption">Login</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/app-vendedores/admin-panel.png" class="glightbox">
                                <img src="~/imgs/captures/app-vendedores/admin-panel.png" alt="App Vendedores - Panel admin">
                            </a>
                            <div class="captura-caption">Panel admin</div>
                        </div>
                    </div>
                </div>

                <div class="links-row">
                    <a href="https://app-vendedores.@dominio" target="_blank" class="modal-visit-btn">Ver demo &rarr;</a>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ==================== PROYECTO 2: Sistema Ventas ==================== -->
<section class="proyecto-seccion" id="sistema-ventas">
    <div class="accordion">
        <button class="accordion-header" onclick="toggleAccordion(this)">
            <div class="accordion-header-left">
                <div class="accordion-icon">
                    <img src="~/imgs/logos/sistema-ventas.png" alt=".NET">
                </div>
                <div>
                    <h3 class="accordion-title">Sistema Ventas</h3>
                    <p class="accordion-subtitle">Gestiona tus productos y ventas sin límites.</p>
                </div>
            </div>
            <div class="accordion-header-right">
                <img src="~/imgs/icons/React.svg" alt="React" title="React">
                <img src="~/imgs/icons/NET.svg" alt=".NET" title=".NET">
                <img src="~/imgs/icons/mysql.svg" alt="MySQL" title="MySQL">
            </div>
            <span class="accordion-arrow">▼</span>
        </button>
        <div class="accordion-panel">
            <div class="accordion-body">

                <div class="proyecto-info-grid">
                    <div class="info-block">
                        <h4 class="info-block-title">Descripción</h4>
                        <p>Plataforma web robusta para la gestión de inventario, ventas y clientes. Incluye un dashboard con estadísticas en tiempo real, control de stock automatizado y reportes detallados. Desarrollada con arquitectura limpia para garantizar escalabilidad y mantenimiento sencillo.</p>
                    </div>
                    <div class="info-block">
                        <h4 class="info-block-title">Características</h4>
                        <ul>
                            <li>Gestión completa de inventario</li>
                            <li>Control de ventas y facturación</li>
                            <li>Administración de clientes</li>
                            <li>Arquitectura limpia y escalable</li>
                            <li>Dashboard simple</li>
                        </ul>
                    </div>
                </div>

                <div class="info-block" style="margin-bottom: 1.5rem;">
                    <h4 class="info-block-title">Tecnologías</h4>
                    <div class="tech-grid">
                        <span class="tech-badge"><img src="~/imgs/icons/React.svg" alt="React"> React</span>
                        <span class="tech-badge"><img src="~/imgs/icons/NET.svg" alt=".NET"> .NET</span>
                        <span class="tech-badge"><img src="~/imgs/icons/mysql.svg" alt="MySQL"> MySQL</span>
                    </div>
                </div>

                <div class="info-block" style="margin-bottom: 1.5rem;">
                    <h4 class="info-block-title">Capturas</h4>
                    <div class="capturas-grid">
                        <div class="captura-item">
                            <a href="~/imgs/captures/sistema-ventas/index.png" class="glightbox">
                                <img src="~/imgs/captures/sistema-ventas/index.png" alt="Sistema Ventas - Dashboard">
                            </a>
                            <div class="captura-caption">Dashboard</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/sistema-ventas/ventas.png" class="glightbox">
                                <img src="~/imgs/captures/sistema-ventas/ventas.png" alt="Sistema Ventas - Ventas">
                            </a>
                            <div class="captura-caption">Lista de Ventas</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/sistema-ventas/productos.png" class="glightbox">
                                <img src="~/imgs/captures/sistema-ventas/productos.png" alt="Sistema Ventas - Productos">
                            </a>
                            <div class="captura-caption">Lista de Productos</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/sistema-ventas/crear-producto.png" class="glightbox">
                                <img src="~/imgs/captures/sistema-ventas/crear-producto.png" alt="Sistema Ventas - Crear Producto">
                            </a>
                            <div class="captura-caption">Crear/Editar Producto</div>
                        </div>
                        <div class="captura-item">
                            <a href="~/imgs/captures/sistema-ventas/crear-venta.png" class="glightbox">
                                <img src="~/imgs/captures/sistema-ventas/crear-venta.png" alt="Sistema Ventas - Crear Venta">
                            </a>
                            <div class="captura-caption">Crear Venta</div>
                        </div>
                    </div>
                </div>

                <div class="links-row">
                    <a href="https://sistema-ventas.@dominio" target="_blank" class="modal-visit-btn">Ver demo &rarr; </a>
                    <a href="https://github.com/NicoPasino/app-notes" target="_blank" class="modal-info-btn">
                        <img src="~/imgs/icons/github.svg" alt="GitHub">
                        Repositorio
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>

<!-- ==================== PROYECTO 3: App Notas ==================== -->
<section class="proyecto-seccion" id="app-notas">
    <div class="accordion">
        <button class="accordion-header" onclick="toggleAccordion(this)">
            <div class="accordion-header-left">
                <div class="accordion-icon">
                    <img src="~/imgs/logos/app-notas.png" alt="React">
                </div>
                <div>
                    <h3 class="accordion-title">App Notas</h3>
                    <p class="accordion-subtitle">Tus ideas en órbita, siempre al alcance.</p>
                </div>
            </div>
            <div class="accordion-header-right">
                <img src="~/imgs/icons/React.svg" alt="React Native" title="React Native">
                <img src="~/imgs/icons/NET.svg" alt=".NET" title=".NET">
                <img src="~/imgs/icons/mysql.svg" alt="MySQL" title="MySQL">
            </div>
            <span class="accordion-arrow">▼</span>
        </button>
        <div class="accordion-panel">
            <div class="accordion-body">

                <div class="proyecto-info-grid">
                    <div class="info-block">
                        <h4 class="info-block-title">Descripción</h4>
                        <p>Aplicación de notas multiplataforma disponible para web y Android. Permite organizar ideas por colores y sincronizar entre dispositivos. Backend robusto en .NET con Entity Framework Core y MySQL, frontend responsive con React Native para una experiencia fluida en cualquier pantalla. Código escrito desde 0 sin uso de IA</p>
                    </div>
                    <div class="info-block">
                        <h4 class="info-block-title">Características</h4>
                        <ul>
                            <li>Multiplataforma: Web y Android</li>
                            <li>Organización por colores</li>
                            <li>Sincronización entre dispositivos</li>
                            <li>Interfaz intuitiva y rápida</li>
                        </ul>
                    </div>
                </div>

                <div class="info-block" style="margin-bottom: 1.5rem;">
                    <h4 class="info-block-title">Tecnologías</h4>
                    <div class="tech-grid">
                        <span class="tech-badge"><img src="~/imgs/icons/React.svg" alt="React"> React Native</span>
                        <span class="tech-badge"><img src="~/imgs/icons/NET.svg" alt=".NET"> .NET</span>
                        <span class="tech-badge"><img src="~/imgs/icons/mysql.svg" alt="MySQL"> MySQL</span>
                    </div>
                </div>

                <div class="info-block" style="margin-bottom: 1.5rem;">
                    <h4 class="info-block-title">Capturas</h4>
                    <div class="capturas-grid">
                        <div class="captura-item">
                            <a href="~/imgs/captures/app-notas/index.png" class="glightbox">
                                <img src="~/imgs/captures/app-notas/index.png" alt="App Notas - Vista principal + Editar Nota">
                            </a>
                            <div class="captura-caption">Vista principal + Editar Nota</div>
                        </div>
                    </div>
                </div>

                <div class="links-row">
                    <a href="https://notas.@dominio" target="_blank" class="modal-visit-btn">Ver demo &rarr;</a>
                    <a href="https://github.com/NicoPasino/app-notes" target="_blank" class="modal-info-btn">
                        <img src="~/imgs/icons/github.svg" alt="GitHub">
                        Repositorio
                    </a>
                </div>

            </div>
        </div>
    </div>
</section>
